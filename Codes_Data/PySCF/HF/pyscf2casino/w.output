# Molecule definition.
mol = gto.Mole()
mol.verbose    = 5
mol.atom       = '''
O    5.00000000   7.14707700   7.65097100
H    4.06806600   6.94297500   7.56376100
H    5.38023700   6.89696300   6.80798400'''
mol.unit       = 'A'
mol.basis      = { 'H': gto.basis.parse(h_basis),
                   'O': gto.basis.parse(o_basis) }
mol.ecp        = { 'H': gto.basis.parse_ecp(h_ecp),
                   'O': gto.basis.parse_ecp(o_ecp) }
mol.charge   = 0
mol.spin     = 0
mol.symmetry = True
mol.output   = 'w.output'
mol.build()

# Run RHF.
mf = scf.RHF(mol).run()

# Produce molden file.
pyscf_tools.molden.from_scf(mf, 'input.molden')
